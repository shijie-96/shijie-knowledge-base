# ======================================================
# zhishi2.0 环境变量模板
# 使用方式：
#   后端：复制本文件为 backend/.env（或根目录 .env）
#   前端：如需覆盖 API 地址，复制为 frontend/.env
# 切勿将真实 .env 提交到版本库
# ======================================================

# ---------- 应用基础 ----------
# 后端服务端口
PORT=3001
# 允许跨域来源（逗号分隔，多个域名用英文逗号隔开）
CORS_ORIGINS=http://localhost:3000

# ---------- PostgreSQL (pgvector) ----------
# 是否启用数据库连接。开发初期未启动 PostgreSQL 时请保持 false，
# 否则后端会因连接失败而无法启动。
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=zhishi
# 是否自动同步表结构（仅开发环境开启，生产请使用 migration）
DB_SYNC=false
DB_LOGGING=false
DB_POOL_MAX=10

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT 认证 ----------
# 生产环境务必替换为强随机密钥
JWT_SECRET=change-me-in-production
# 访问令牌有效期
JWT_EXPIRES_IN=7d
# 刷新令牌有效期（预留）
JWT_REFRESH_EXPIRES_IN=30d

# ---------- AI 配置加密（用户自备大模型 API Key） ----------
# 用于 AES-256 加密登录用户的 API Key 入库。
# 必须为强随机长字符串（建议 32 位以上随机字符）。
# ⚠️ 绝对不要提交到 git；丢失后已存密钥无法解密（用户需重新配置）。
AI_CONFIG_AES_SECRET=

# ---------- 阿里云 OSS（生产环境） ----------
# 开发环境使用本地存储（backend/uploads），生产切换为 OSS
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=
# 本地存储目录（开发环境）
LOCAL_UPLOAD_DIR=./uploads

# ---------- 支付模式（模拟支付开关） ----------
# 支付/订阅直通保护：控制「创建支付记录 → 立即成功」的模拟路径。
#   开发/测试：默认 mock（允许直通，便于联调）
#   生产：默认关闭（fail-closed，未接入真实网关前任何订阅/购买都会被拒绝）
#   可选值：mock | gateway
# PAY_MODE=gateway 仅应在接入真实支付网关后配置。
#PAY_MODE=mock

# ---------- 老账号默认密码兜底（安全策略） ----------
# 历史账号（从未设置密码）默认按 SMS_DEV_CODE / 123456 校验登录。
# 生产环境默认禁止该兜底；确需灰度迁移请显式开启（迁移完成后应关闭并让用户改密）：
#ALLOW_LEGACY_DEFAULT_PASSWORD=true

# ---------- AI 接口（预留） ----------
# 示例：AI_API_BASE_URL=https://api.deepseek.com（OpenAI 兼容，无需 /v1）
AI_API_BASE_URL=
AI_API_KEY=
AI_MODEL=deepseek-v4-flash

# ---------- 大模型调用（OPENAI 兼容，未配置时启发式降级） ----------
# 文本生成：AI 辅助提炼
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
# 向量生成：pgvector 语义搜索（未配置时使用启发式 1536 维词袋向量）
LLM_EMBEDDING_URL=
LLM_EMBEDDING_KEY=
LLM_EMBEDDING_MODEL=text-embedding-3-small

# ---------- 前端（NEXT_PUBLIC_ 前缀会注入浏览器） ----------
# 浏览器访问后端的地址；部署后改为线上域名
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
